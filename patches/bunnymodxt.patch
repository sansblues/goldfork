+// ---- fork: branch a running TAS with fork(2) -------------------------------
+//
+// A child continues from the exact frame the parent forked on, with the rest
+// of the script replaced. Everything already played must be identical, so a
+// child's run equals a linear run of the child's script.
+
+// Serializes the first n frame bulks; the bulk at index `partial` (if any) is
+// compared with its repeat count normalized, since it may only get longer.
+static std::string SerializeFramePrefix(const std::vector<HLTAS::Frame>& frames, size_t n, size_t partial)
+{
+	HLTAS::Input tmp;
+	for (size_t i = 0; i < n; ++i) {
+		HLTAS::Frame f = frames[i];
+		if (i == partial)
+			f.SetRepeats(1);
+		tmp.InsertFrame(i, f);
+	}
+
+	// Grow as needed: a large zeroed buffer would cost every fork child
+	// thousands of page faults.
+	std::vector<char> buf(1 << 16);
+	while (tmp.ToString(buf.data(), buf.size()).Code != HLTAS::ErrorCode::OK) {
+		if (buf.size() >= (1u << 28))
+			return "<unserializable>";
+		buf.resize(buf.size() * 4);
+	}
+	return std::string(buf.data());
+}
+
+// The played prefix, serialized once by bxt_fork before forking, so that each
+// child only serializes its own script.
+static struct {
+	size_t n = SIZE_MAX, partial = SIZE_MAX;
+	std::string text;
+} forkPlayedPrefix;
+
+bool HwDLL::ContinueTASScript(const char *fileName)
+{
+	if (!runningFrames) {
+		ORIG_Con_Printf("_bxt_tas_continue: no TAS script is running.\n");
+		return false;
+	}
+
+	HLTAS::Input next;
+	auto err = next.Open(fileName);
+	if (err.Code != HLTAS::ErrorCode::OK) {
+		ORIG_Con_Printf("_bxt_tas_continue: error loading %s on line %u: %s\n", fileName, err.LineNumber, HLTAS::GetErrorMessage(err).c_str());
+		return false;
+	}
+
+	const auto& played = input.GetFrames();
+	const auto& frames = next.GetFrames();
+	const size_t n = currentFramebulk + (currentRepeat ? 1 : 0);
+	const size_t partial = currentRepeat ? currentFramebulk : SIZE_MAX;
+
+	if (next.GetProperties() != input.GetProperties()
+			|| frames.size() < n
+			|| (currentRepeat && frames[currentFramebulk].GetRepeats() <= currentRepeat)
+			|| SerializeFramePrefix(frames, n, partial) != (forkPlayedPrefix.n == n && forkPlayedPrefix.partial == partial
+				? forkPlayedPrefix.text : SerializeFramePrefix(played, n, partial))) {
+		ORIG_Con_Printf("_bxt_tas_continue: %s does not match the part already played (%zu bulks, %u frames into the last).\n", fileName, currentFramebulk, currentRepeat);
+		return false;
+	}
+
+	input = std::move(next);
+	totalFramebulks = input.GetFrames().size();
+
+	// The frame time of the coming frame was already chosen, by looking ahead
+	// into the old script (InsertCommands queues host_framerate before the
+	// frame's own commands, including the one that got us here). Choose it again
+	// from the new script, unless a 0 ms frame is queued: that decision comes
+	// from the frame just played, which both scripts share.
+	if (!thisFrameIs0ms) {
+		HLTAS::Frame upcoming;
+		if (GetNextMovementFrame(upcoming)) {
+			std::ostringstream ss;
+			ss << "host_framerate " << upcoming.Frametime << "\n";
+			ORIG_Cbuf_InsertText(ss.str().c_str());
+		}
+	}
+	totalFrames = 0;
+	for (size_t i = currentFramebulk; i < totalFramebulks; ++i) {
+		const auto& f = input.GetFrame(i);
+		if (f.IsMovement())
+			totalFrames += f.GetRepeats() - (i == currentFramebulk ? currentRepeat : 0);
+	}
+	return true;
+}
+
+struct HwDLL::Cmd_BXT_TAS_Continue
+{
+	USAGE("Usage: _bxt_tas_continue <filename>\n Replaces the rest of the running .hltas script with the frames of another script. Everything already played must be identical in both.\n");
+
+	static void handler(const char *fileName)
+	{
+		HwDLL::GetInstance().ContinueTASScript(fileName);
+	}
+};
