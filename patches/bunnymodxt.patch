+#ifndef _WIN32
+void HwDLL::BecomeForkChild(const char *scriptName, const char *logName)
+{
+	// Leave the parent's log without writing to it: point the inherited
+	// descriptor at /dev/null, then close the log as usual.
+	if (tasLogging) {
+		int devnull = open("/dev/null", O_WRONLY);
+		dup2(devnull, fileno(tasLogFile));
+		close(devnull);
+		SetTASLogging(false);
+	}
+
+	if (logName[0]) {
+		CVars::bxt_taslog_filename.Set(logName);
+		SetTASLogging(true);
+	}
+	forkChildLog = logName;
+	forkChild = true;
+
+	if (!ContinueTASScript(scriptName))
+		_exit(2);
+
+	// A hung child would stall its worker forever.
+	const char *timeout = std::getenv("BXT_FORK_TIMEOUT");
+	alarm(timeout ? std::atoi(timeout) : 120);
+}
+#endif
+
+#ifndef _WIN32
+// A fork child ends where its run leaves the map: the log holds every frame up
+// to the one that caused it, and <log>.end says why ("changelevel c1a3").
+// Loading a map would only cost time, and children would race on save files.
+void HwDLL::EndForkChild(const char *why, const char *map)
+{
+	if (!forkChildLog.empty()) {
+		if (FILE *f = std::fopen((forkChildLog + ".end").c_str(), "w")) {
+			std::fprintf(f, "%s %s\n", why, map);
+			std::fclose(f);
+		}
+	}
+	SetTASLogging(false);
+	std::fflush(nullptr);
+	_exit(0);
+}
+
+// Runs one batch of `count` children from the current frame through a fork
+// tree (one worker per job, each forking its share serially: forking a big
+// process is slow, so the parent alone would bottleneck). Returns true in a
+// child, which must then return and play on; false in the parent once all
+// children have finished.
+bool HwDLL::RunForkBatch(int count, int jobs, const char *scriptPattern, const char *logPattern, int& started, int& failed)
+{
+	auto& hw = *this;
+	if (jobs < 1)
+		jobs = 1;
+	started = failed = 0;
+
+	forkPlayedPrefix.n = hw.currentFramebulk + (hw.currentRepeat ? 1 : 0);
+	forkPlayedPrefix.partial = hw.currentRepeat ? hw.currentFramebulk : SIZE_MAX;
+	forkPlayedPrefix.text = SerializeFramePrefix(hw.input.GetFrames(), forkPlayedPrefix.n, forkPlayedPrefix.partial);
+
+	// Children must not inherit buffered output.
+	std::fflush(nullptr);
+
+	std::vector<pid_t> workers;
+	for (int w = 0; w < jobs && w < count; ++w) {
+		const pid_t pid = fork();
+		if (pid == 0) {
+			int bad = 0;
+			for (int i = w; i < count; i += jobs) {
+				char script[1024], log[1024];
+				std::snprintf(script, sizeof script, scriptPattern, i);
+				std::snprintf(log, sizeof log, logPattern, i);
+
+				const pid_t child = fork();
+				if (child == 0) {
+					hw.BecomeForkChild(script, log);
+					return true;
+				}
+				int status = 0;
+				if (child < 0 || waitpid(child, &status, 0) < 0 || !WIFEXITED(status) || WEXITSTATUS(status) != 0)
+					++bad;
+			}
+			_exit(bad > 254 ? 254 : bad);
+		}
+		if (pid < 0) {
+			hw.ORIG_Con_Printf("bxt_fork: fork failed: %s\n", std::strerror(errno));
+			break;
+		}
+		workers.push_back(pid);
+		started += (count - w + jobs - 1) / jobs;
+	}
+	for (pid_t pid : workers) {
+		int status = 0;
+		if (waitpid(pid, &status, 0) < 0 || !WIFEXITED(status))
+			failed += (count + jobs - 1) / jobs;
+		else
+			failed += WEXITSTATUS(status);
+	}
+
+	forkPlayedPrefix.n = SIZE_MAX;
+	return false;
+}
+#endif
+
+struct HwDLL::Cmd_BXT_Fork
+{
+	USAGE("Usage: bxt_fork <count> <jobs> <script_pattern> <log_pattern>\n Forks <count> copies of the game at this frame, at most <jobs> running at once. Child i continues with the script <script_pattern> and logs to <log_pattern> (printf-style, %d is i; an empty log pattern disables logging). The parent waits for all children, then continues. Linux only.\n");
+
+	static void handler(int count, int jobs, const char *scriptPattern, const char *logPattern)
+	{
+#ifdef _WIN32
+		HwDLL::GetInstance().ORIG_Con_Printf("bxt_fork is only available on Linux.\n");
+#else
+		auto& hw = HwDLL::GetInstance();
+		if (!hw.runningFrames) {
+			hw.ORIG_Con_Printf("bxt_fork: no TAS script is running.\n");
+			return;
+		}
+
+		const auto start = std::chrono::steady_clock::now();
+		int started, failed;
+		if (hw.RunForkBatch(count, jobs, scriptPattern, logPattern, started, failed))
+			return; // A child: play on from here.
+
+		const std::chrono::duration<double> took = std::chrono::steady_clock::now() - start;
+		hw.ORIG_Con_Printf("bxt_fork: %d children in %.3f s, %d failed.\n", started, took.count(), failed);
+#endif
+	}
+};
+
+struct HwDLL::Cmd_BXT_Fork_Serve
+{
+	USAGE("Usage: bxt_fork_serve <request_fifo> <reply_fifo>\n Stays at this frame and serves batches of forked children. Each request line is \"batch <count> <jobs> <script_pattern> <log_pattern>\" (as bxt_fork; \"-\" for no log) and is answered with \"done <started> <failed> <seconds>\"; \"quit\" ends serving and the script plays on. Linux only.\n");
+
+	static void handler(const char *requestPath, const char *replyPath)
+	{
+#ifdef _WIN32
+		HwDLL::GetInstance().ORIG_Con_Printf("bxt_fork_serve is only available on Linux.\n");
+#else
+		auto& hw = HwDLL::GetInstance();
+		if (!hw.runningFrames) {
+			hw.ORIG_Con_Printf("bxt_fork_serve: no TAS script is running.\n");
+			return;
+		}
+
+		FILE *requests = std::fopen(requestPath, "r");
+		FILE *replies = std::fopen(replyPath, "w");
+		if (!requests || !replies) {
+			hw.ORIG_Con_Printf("bxt_fork_serve: cannot open %s / %s: %s\n", requestPath, replyPath, std::strerror(errno));
+			if (requests) std::fclose(requests);
+			if (replies) std::fclose(replies);
+			return;
+		}
+
+		char line[4096];
+		while (std::fgets(line, sizeof line, requests)) {
+			int count, jobs;
+			char scriptPattern[1024], logPattern[1024];
+			if (std::sscanf(line, "batch %d %d %1023s %1023s", &count, &jobs, scriptPattern, logPattern) == 4) {
+				const char *log = std::strcmp(logPattern, "-") ? logPattern : "";
+				const auto start = std::chrono::steady_clock::now();
+				int started, failed;
+				if (hw.RunForkBatch(count, jobs, scriptPattern, log, started, failed))
+					return; // A child: leave the server's files alone and play on.
+				const std::chrono::duration<double> took = std::chrono::steady_clock::now() - start;
+				std::fprintf(replies, "done %d %d %.6f\n", started, failed, took.count());
+			} else if (!std::strncmp(line, "quit", 4)) {
+				break;
+			} else {
+				std::fprintf(replies, "error bad request\n");
+			}
+			std::fflush(replies);
+		}
+
+		std::fclose(requests);
+		std::fclose(replies);
+#endif
+	}
+};
+
+struct HwDLL::Cmd_BXT_Fork_Exit
+{
+	USAGE("Usage: _bxt_fork_exit\n Finishes the TAS log and exits at once, skipping engine shutdown. Ends a bxt_fork child.\n");
+
+	static void handler()
+	{
+		auto& hw = HwDLL::GetInstance();
+		hw.SetTASLogging(false);
+		std::fflush(nullptr);
+#ifdef _WIN32
+		std::exit(0);
+#else
+		_exit(0);
+#endif
+	}
+};
